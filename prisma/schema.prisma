// Prisma schema — 短视频脚本 AI 工具
// PostgreSQL (Neon 托管):DATABASE_URL 为池化连接,迁移/DDL 走 DATABASE_URL_UNPOOLED

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// 项目(一个选题)
model Project {
  id              String   @id @default(cuid())
  topic           String
  description     String   @default("")
  niche           String   @default("")
  productCategory String   @default("") // 产品品类(中文标签)
  productName     String   @default("")
  brief           String   @default("") // 简报钩子预览
  audience        String   @default("")
  platform    String   @default("tiktok")
  durationSec Int      @default(30)
  language    String   @default("English")
  style       String   @default("")
  goal        String   @default("")
  status      String   @default("active")
  userId      String? // 归属用户(单密码登录/免登录时为 null)
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  starred     Boolean  @default(false)
  archivedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  materials Material[]
  angles    Angle[]
  jobs      Job[]
}

// 素材(字段化录入)
model Material {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type       String // fact | data | quote | feature | keyword | story
  content    String
  isRequired Boolean  @default(true)
  createdAt  DateTime @default(now())
}

// 内容角度
model Angle {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title     String
  premise   String
  whyItWorks String  @default("")
  explanationZh String @default("") // 中文大白话解析,让执行者秒懂方案
  cards     String   @default("{}") // 创意牌组快照 JSON
  score     Float?
  status    String   @default("draft") // draft | selected | rejected
  createdAt DateTime @default(now())

  hooks   Hook[]
  outline Outline?
}

// 钩子
model Hook {
  id        String   @id @default(cuid())
  angleId   String
  angle     Angle    @relation(fields: [angleId], references: [id], onDelete: Cascade)
  text      String
  hookType  String // 公式库中的钩子类型 id
  scores    String   @default("{}") // rubric 各维度分 JSON
  total     Float?
  selected  Boolean  @default(false)
  createdAt DateTime @default(now())
}

// 大纲(素材引用锁死)
model Outline {
  id        String   @id @default(cuid())
  angleId   String   @unique
  angle     Angle    @relation(fields: [angleId], references: [id], onDelete: Cascade)
  sections  String // JSON: [{beat, timeRange, direction, materialRefs[]}]
  status    String   @default("draft") // draft | locked
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  scripts Script[]
}

// 脚本(分镜正文)
model Script {
  id        String   @id @default(cuid())
  outlineId String
  outline   Outline  @relation(fields: [outlineId], references: [id], onDelete: Cascade)
  version   Int      @default(1)
  hookText  String   @default("")
  segments  String // JSON: [{time, voiceover, visual, onscreenText}]
  scores    String   @default("{}")
  cards     String   @default("{}") // 生成时牌组快照
  status    String   @default("draft") // draft | edited | approved
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reviews  Review[]
  editLogs EditLog[]
}

// 评审记录
model Review {
  id         String   @id @default(cuid())
  scriptId   String
  script     Script   @relation(fields: [scriptId], references: [id], onDelete: Cascade)
  dimensions String // JSON: {name: {score, reason}}
  findings   String   @default("[]") // JSON
  avgScore   Float?
  passed     Boolean  @default(false)
  attempt    Int      @default(0)
  createdAt  DateTime @default(now())
}

// 编辑记录(微调数据飞轮)
model EditLog {
  id        String   @id @default(cuid())
  scriptId  String
  script    Script   @relation(fields: [scriptId], references: [id], onDelete: Cascade)
  field     String
  before    String
  after     String
  createdAt DateTime @default(now())
}

// 内置案例库(含用户收藏的脚本)
model Case {
  id         String   @id @default(cuid())
  userId     String? // 收藏归属(null = 内置语料)
  category   String // hook | structure | script
  content    String
  tags       String // JSON
  usageCount Int      @default(0)
  createdAt  DateTime @default(now())
}

// 用户(多账号)
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         String   @default("user") // user | admin
  createdAt    DateTime @default(now())

  projects Project[]
  jobs     Job[]
}

// 后台生成任务(进度/取消/用量统计;Phase B 启用)
model Job {
  id         String    @id @default(cuid())
  userId     String?
  user       User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId  String?
  project    Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stage      String // brief | angles | hooks | outline | scripts | review | autopilot
  status     String    @default("pending") // pending | running | succeeded | failed | cancelled
  progress   String    @default("{}") // JSON:阶段进度
  result     String    @default("{}") // JSON:终态结果(如 briefs 列表)
  error      String?
  tokensIn   Int       @default(0)
  tokensOut  Int       @default(0)
  model      String    @default("")
  costUsd    Float     @default(0)
  createdAt  DateTime  @default(now())
  startedAt  DateTime?
  finishedAt DateTime?
}
