# 数据库(PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/videoscripts"

# apiyi 中转(OpenAI 兼容格式)
AI_API_KEY=""
AI_BASE_URL="https://api.apiyi.com/v1"

# 模型名(开工后可用 GET /v1/models 确认可用名)
MODEL_CREATIVE="claude-opus-4-6"
MODEL_CRITIC="claude-opus-4-6"
MODEL_FALLBACKS="claude-opus-4-6"

# 可选:超时(毫秒)与生成并发
AI_TIMEOUT_MS="120000"
AI_CONCURRENCY="4"

# 访问保护(上线必填,本地留空则跳过登录)
APP_PASSWORD=""
AUTH_SECRET=""

# 多账号:首个注册账号即管理员;后续注册需设为 true
ALLOW_REGISTRATION="false"
