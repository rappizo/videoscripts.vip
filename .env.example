# 数据库(SQLite 单文件)
DATABASE_URL="file:./dev.db"

# apiyi 中转(OpenAI 兼容格式)
AI_API_KEY=""
AI_BASE_URL="https://api.apiyi.com/v1"

# 模型名(开工后可用 GET /v1/models 确认可用名)
MODEL_CREATIVE="claude-opus-5"
MODEL_CRITIC="claude-sonnet-5"
MODEL_FALLBACKS="claude-sonnet-5,claude-sonnet-4-6,claude-opus-4-6"

# 可选:超时(毫秒)与生成并发
AI_TIMEOUT_MS="120000"
AI_CONCURRENCY="4"
